{
  "name": "findthedead",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "seed:build": "node --experimental-strip-types scripts/build-seed.ts",
    "seed:check": "node --experimental-strip-types scripts/build-seed.ts --check",
    "test:db": "node --experimental-strip-types --test tests/database.test.ts",
    "ingest:wikidata": "node --experimental-strip-types scripts/ingest-wikidata.ts",
    "ingest:michigan": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/ingest-michigan.ts",
    "ingest:us": "node --experimental-strip-types scripts/ingest-us.ts",
    "enrich:us": "node --experimental-strip-types scripts/enrich-us.ts",
    "report:us": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/report-us.ts",
    "evidence:us": "node --experimental-strip-types scripts/evidence-us.ts",
    "research:us": "node --max-old-space-size=2048 --experimental-strip-types scripts/research-us.ts",
    "release:batch": "node --experimental-strip-types scripts/release-batch.ts",
    "publish:reviewed": "node --experimental-strip-types scripts/publish-reviewed-candidates.ts",
    "release:reviewed": "node --experimental-strip-types scripts/release-reviewed-candidates.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "mapbox-gl": "3.30.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "type": "module"
}
