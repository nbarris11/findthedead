# Public origin for canonical URLs. Change when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit offline preview. Do not enable in production.
DATA_MODE=demo
# Required only when DATA_MODE=supabase. Prefer a publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, optional:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved for trusted offline ingestion scripts; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Required for the future Mapbox explore milestone, not this foundation.
NEXT_PUBLIC_MAPBOX_TOKEN=
